{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevHub",
  "version": "0.4.4",
  "identifier": "com.xiaoxiaol123456.devhub",
  "build": {
    "beforeDevCommand": "pnpm build:explorer && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:explorer && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevHub",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "resources": ["resources/node-http-server.cjs", "resources/explorer/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1MTE2REQ2MDg5QzQzNDAKUldSQVE1d0kxbTBSNVFXeDh6dWJoQWNiUU1ZallVUG9WQjRQZVBGTWpWVEM5TUtsUWRpZG1KRnYK",
      "endpoints": [
        "https://github.com/xiaoxiaolexlh/devhub/releases/latest/download/latest.json"
      ]
    }
  }
}
